use aiken/builtin
use aiken/primitive/bytearray

// Two ASCII bytes per possible input byte; indexed only by an actual byte.
const pairs = ""

// Encode directly into lowercase ASCII with one table slice per input byte.
// The lookup avoids division, remainder and two separate character lookups.
pub fn lower_hex(value: ByteArray) -> ByteArray {
  encode(value, bytearray.length(value) - 1, "")
}

fn encode(value: ByteArray, cursor: Int, acc: ByteArray) -> ByteArray {
  if cursor < 0 {
    acc
  } else {
    let byte = bytearray.at(value, cursor)
    encode(
      value,
      cursor - 1,
      builtin.append_bytearray(builtin.slice_bytearray(byte * 2, 2, pairs), acc),
    )
  }
}

test transfer_hex_all_byte_values_and_empty() {
  lower_hex(#"") == "" && lower_hex("") == ""
}
